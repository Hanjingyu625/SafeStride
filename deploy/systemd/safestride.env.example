SAFESTRIDE_WORKSPACE=/opt/safestride
SAFESTRIDE_CONFIG=/opt/safestride/config/raspberry_pi.yaml
SAFESTRIDE_WHEEL_RADIUS_M=0.15
SAFESTRIDE_WHEEL_SEPARATION_M=0.55
SAFESTRIDE_ENABLE_TERRAIN=true
SAFESTRIDE_ENABLE_PERCEPTION=false
SAFESTRIDE_PERCEPTION_VENV=/opt/safestride/.venv-perception
SAFESTRIDE_PERCEPTION_MODEL=/opt/safestride/raspberry_pi/road_surface_inference/road_surface_public_mix_torchscript.pt
SAFESTRIDE_PERCEPTION_CLASSES=/opt/safestride/raspberry_pi/road_surface_inference/target_classes.json
SAFESTRIDE_PERCEPTION_CAMERA_INDEX=0
SAFESTRIDE_PERCEPTION_CAMERA_BACKEND=v4l2
SAFESTRIDE_ENABLE_GPS=false
SAFESTRIDE_ENABLE_CROSSWALK=false
ROS_DOMAIN_ID=42
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
