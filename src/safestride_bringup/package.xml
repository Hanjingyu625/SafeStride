<?xml version="1.0"?>
<package format="3">
  <name>safestride_bringup</name>
  <version>0.1.0</version>
  <description>Launch and configuration files for the SafeStride walker.</description>

  <maintainer email="maintainer@example.com">SafeStride Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>safestride_control</exec_depend>
  <exec_depend>safestride_bridge</exec_depend>
  <exec_depend>safestride_description</exec_depend>
  <exec_depend>safestride_interfaces</exec_depend>
  <exec_depend>safestride_navigation</exec_depend>
  <exec_depend>safestride_perception</exec_depend>
  <exec_depend>safestride_sensors</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
