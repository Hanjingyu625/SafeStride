<?xml version="1.0"?>
<package format="3">
  <name>safestride_navigation</name>
  <version>0.1.0</version>
  <description>GPS crosswalk detection and crossing-assist policy for SafeStride.</description>
  <maintainer email="maintainer@example.com">SafeStride maintainers</maintainer>
  <license>Apache-2.0</license>

  

  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>safestride_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
