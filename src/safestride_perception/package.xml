<?xml version="1.0"?>
<package format="3">
  <name>safestride_perception</name>
  <version>0.1.0</version>
  <description>Fail-safe road-surface perception for SafeStride.</description>
  <maintainer email="maintainer@example.com">SafeStride maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>safestride_interfaces</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
